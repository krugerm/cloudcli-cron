{
  "name": "cloudcli-plugin-workspace-scheduled-prompts",
  "version": "0.4.0",
  "private": true,
  "description": "CloudCLI plugin for workspace-scoped scheduled prompts.",
  "type": "module",
  "engines": {
    "node": ">=22.13 <23 || >=23.4"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && esbuild src/index.ts --bundle --format=esm --platform=browser --outfile=dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "@types/node": "^24.6.0",
    "cron-parser": "^5.10.3",
    "cronstrue": "^3.38.0",
    "esbuild": "^0.25.11",
    "luxon": "^3.7.2",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "jsdom": "^26.1.0",
    "vitest": "^3.2.4"
  }
}
